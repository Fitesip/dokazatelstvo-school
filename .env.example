# Скопируйте в .env и заполните. Для разработки достаточно BETTER_AUTH_SECRET.

# База данных.
#   Разработка: не задавайте — npm run dev сам поднимает PGlite (PostgreSQL внутри Node)
#   из ./.data/pglite и раздаёт её на postgres://postgres:postgres@127.0.0.1:5433/postgres.
#   Сервер: задаётся в docker-compose.yml.
# DATABASE_URL=

# Адрес сайта (ссылки в письмах, проверка источника запросов)
BETTER_AUTH_URL=http://localhost:3000
# Случайная строка от 32 символов: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Почта. Если SMTP_HOST пуст — письма не отправляются, а печатаются в консоль сервера.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Доказательство <no-reply@example.com>"

# Учебная витрина /dev/shop и страница-заглушка оплаты (до подключения ЮKassa/Robokassa)
DEMO_SHOP=1
