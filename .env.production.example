# Скопируйте на сервере в .env (рядом с docker-compose.yml) и заполните.

# Пока нет домена — ":80" и адрес по IP; после покупки домена — "example.ru" и https://example.ru
SITE_ADDRESS=:80
BETTER_AUTH_URL=http://<IP-сервера>

# Случайные строки: openssl rand -base64 32
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=

# Почта на домене (после покупки домена). Пусто — письма видны в `docker compose logs app`.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Доказательство <no-reply@example.ru>"

# Страница-заглушка оплаты — до подключения настоящей платёжной системы
DEMO_SHOP=1
